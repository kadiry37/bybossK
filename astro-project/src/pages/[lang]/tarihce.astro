---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar';
import Footer from '../../components/Footer';
import { getSettings, getNavigation, getTimeline } from '../../lib/api';

export function getStaticPaths() {
  return [
    { params: { lang: 'tr' } },
    { params: { lang: 'en' } },
    { params: { lang: 'ar' } },
  ];
}

const { lang } = Astro.params;
const langPrefix = lang === 'tr' ? '' : `/${lang}`;

const API_URL = 'https://bybossmimarlik.com/api';

let settingsData = null;
let navData = null;
let timelineData = [];
try {
  settingsData = await getSettings(lang);
  navData = await getNavigation(lang);
  timelineData = await getTimeline(lang); // Timeline translates maybe? I didn't see timeline translations
} catch (e) {}
---

<Layout 
  title={lang === 'en' ? 'Our History' : (lang === 'ar' ? 'تاريخنا' : 'Tarihçemiz')} 
  description={lang === 'en' ? 'The history and development process of By Boss Mimarlık Mobilya' : (lang === 'ar' ? 'تاريخ وعملية تطوير شركة By Boss Mimarlık Mobilya' : 'By Boss Mimarlık Mobilya firmasının tarihçesi ve gelişim süreci')}
  footerScripts={settingsData?.footer?.scripts || ''}
  logo={settingsData?.general?.logo || ''}
  favicon={settingsData?.general?.favicon || ''}
  lang={lang}
>

  <main class="min-h-screen pt-24 pb-16 bg-noir-900">
    <Navbar client:load data={settingsData} navData={navData?.header} lang={lang} />

    
    <div class="container mx-auto px-6">
      <div class="text-center mb-16">
        <span class="inline-block px-4 py-2 border border-gold-500/30 text-gold-500 text-sm font-medium tracking-widest uppercase mb-6">
          {lang === 'en' ? 'Our Story' : (lang === 'ar' ? 'قصتنا' : 'Hikayemiz')}
        </span>
        <h1 class="font-serif text-5xl md:text-6xl font-bold text-white mb-6">
          {lang === 'en' ? 'His' : (lang === 'ar' ? 'تار' : 'Tarih')}<span class="gradient-text">{lang === 'en' ? 'tory' : (lang === 'ar' ? 'يخ' : 'çe')}</span>
        </h1>
        <p class="text-noir-400 text-lg max-w-2xl mx-auto">
          {settingsData?.general?.tagline || (lang === 'en' ? 'We have been offering innovative solutions in architecture and custom furniture since 2012.' : (lang === 'ar' ? 'نحن نقدم حلولاً مبتكرة في مجال الهندسة المعمارية والأثاث المخصص منذ عام ٢٠١٢.' : "2012'den bu yana mimari tasarım ve özel mobilya üretiminde yenilikçi çözümler sunuyoruz."))}
        </p>
      </div>


      <!-- Timeline -->
      <div class="relative max-w-6xl mx-auto" id="timeline-root">
        <div class="absolute left-1/2 top-0 bottom-0 w-px bg-gradient-to-b from-transparent via-gold-500/50 to-transparent transform -translate-x-1/2 hidden md:block"></div>
        
        {(!timelineData || timelineData.length === 0) ? (
          <div class="text-center py-20 text-noir-400 bg-noir-800/50 rounded-2xl border border-noir-700 relative z-10">
            <p class="text-xl">{lang === 'en' ? 'History content has not been added yet.' : (lang === 'ar' ? 'لم يتم إضافة محتوى التاريخ بعد.' : 'Henüz tarihçe içeriği eklenmemiş.')}</p>
            <a href={`${langPrefix || '/'}`} class="text-gold-500 mt-4 inline-block hover:underline">{lang === 'en' ? 'Back to Home' : (lang === 'ar' ? 'العودة إلى الصفحة الرئيسية' : 'Ana Sayfaya Dön')}</a>
          </div>
        ) : (

          timelineData.map((item, idx) => (
            <div class="relative mb-24 md:mb-40 last:mb-0 group z-10">
              <div class={`flex flex-col md:flex-row items-center ${idx % 2 === 0 ? '' : 'md:flex-row-reverse'} gap-8 md:gap-20`}>
                
                <!-- Content Side -->
                <div class={`w-full md:w-1/2 ${idx % 2 === 0 ? 'md:text-right' : 'md:text-left'}`}>
                  <div class="inline-block px-4 py-2 bg-gold-500/10 border border-gold-500/20 rounded-full text-gold-500 font-bold text-lg mb-4">
                    {item.year}
                  </div>
                  <h3 class="text-3xl md:text-4xl font-serif font-bold text-white mb-6 group-hover:text-gold-500 transition-colors">
                    {item.title}
                  </h3>
                  <p class="text-noir-300 text-lg leading-relaxed font-light">
                    {item.description}
                  </p>
                </div>

                <!-- Indicator (Center Circle) -->
                <div class="hidden md:flex absolute left-1/2 transform -translate-x-1/2 items-center justify-center z-10">
                    <div class="w-12 h-12 bg-noir-900 border-2 border-gold-500 rounded-full flex items-center justify-center group-hover:scale-125 group-hover:bg-gold-500 transition-all duration-500">
                        <div class="w-3 h-3 bg-gold-500 rounded-full group-hover:bg-noir-900"></div>
                    </div>
                </div>

                <!-- Image Side -->
                <div class="w-full md:w-1/2">
                  <div class="relative aspect-[16/10] overflow-hidden rounded-xl border border-noir-700 bg-noir-800 group-hover:border-gold-500 transition-all duration-500 shadow-2xl">
                    {item.image ? (
                      <img src={item.image} alt={item.title} class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-1000" />
                    ) : (
                      <div class="w-full h-full flex items-center justify-center font-serif text-gold-500/20 text-9xl">
                        {item.year.substring(0, 2)}
                      </div>
                    )}
                    <div class="absolute inset-0 bg-gradient-to-t from-noir-900 via-transparent to-transparent opacity-60"></div>
                  </div>
                </div>

              </div>
            </div>
          ))
        )}
      </div>
    </div>

    <Footer client:visible data={settingsData} navData={navData?.footer} lang={lang} />

  </main>
</Layout>

<style>
  .gradient-text {
    background: linear-gradient(135deg, #c9a962 0%, #f0d98a 50%, #c9a962 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
</style>
