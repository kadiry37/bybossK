---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar';
import Footer from '../../components/Footer';
import { getSettings, getNavigation } from '../../lib/api';

export function getStaticPaths() {
  return [
    { params: { lang: 'tr' } },
    { params: { lang: 'en' } },
    { params: { lang: 'ar' } },
  ];
}

const { lang } = Astro.params;

let settingsData = null;
let navData = null;
try {
  settingsData = await getSettings(lang);
  navData = await getNavigation(lang);
} catch (e) {
  console.error("API Fetch Error:", e);
}

const siteName = settingsData?.general?.siteName || 'By Boss Mimarlık Mobilya';
---

<Layout 
  title={`${lang === 'en' ? 'Privacy Policy' : (lang === 'ar' ? 'سياسة الخصوصية' : 'Gizlilik Politikası')} | ${siteName}`} 
  description={lang === 'en' ? 'Privacy policy and data security information' : (lang === 'ar' ? 'سياسة الخصوصية ومعلومات أمن البيانات' : 'Gizlilik politikası ve veri güvenliği bilgilendirmesi')}
  footerScripts={settingsData?.footer?.scripts || ''}
  logo={settingsData?.general?.logo || ''}
  favicon={settingsData?.general?.favicon || ''}
  lang={lang}
>
  <main class="min-h-screen pt-32 pb-20 bg-noir-900">
    <Navbar client:load data={settingsData} navData={navData?.header} />
    
    <div class="container mx-auto px-6 max-w-4xl">
      <h1 class="font-serif text-4xl md:text-5xl font-bold text-white mb-10 text-center">
        {lang === 'en' ? 'Privacy' : (lang === 'ar' ? 'خصوصية' : 'Gizlilik')} <span class="text-gold-500">{lang === 'en' ? 'Policy' : (lang === 'ar' ? 'سياسة' : 'Politikası')}</span>
      </h1>
      
      <div class="prose prose-invert max-w-none text-noir-300 space-y-6">
        {settingsData?.legal?.privacyPolicy ? (
          <div class="whitespace-pre-line" set:html={settingsData.legal.privacyPolicy} />
        ) : (
          <div class="space-y-6">
            <p>{lang === 'en' ? 'Last update: April 5, 2026' : (lang === 'ar' ? 'آخر تحديث: 5 أبريل 2026' : 'Son güncelleme: 5 Nisan 2026')}</p>
            
            <section>
              <h2 class="text-white text-2xl font-bold mb-4">1. {lang === 'en' ? 'Data Controller' : (lang === 'ar' ? 'مراقب البيانات' : 'Veri Sorumlusu')}</h2>
              <p>{lang === 'en' ? `This privacy policy is intended to provide information on the protection of personal data collected and processed by ${siteName}.` : (lang === 'ar' ? `تهدف سياسة الخصوصية هذه إلى توفير معلومات حول حماية البيانات الشخصية التي يتم جمعها ومعالجتها بواسطة ${siteName}.` : `Bu gizlilik politikası, ${siteName} tarafından toplanan ve işlenen kişisel verilerin korunmasına yönelik bilgilendirme amacı taşımaktadır.`)}</p>
            </section>

            <section>
              <h2 class="text-white text-2xl font-bold mb-4">2. {lang === 'en' ? 'Collected Data' : (lang === 'ar' ? 'البيانات التي تم جمعها' : 'Toplanan Veriler')}</h2>
              <p>{lang === 'en' ? 'Information such as your name, surname, e-mail address and telephone number may be collected through the contact forms on our website. This information is only used to get back to you.' : (lang === 'ar' ? 'قد يتم جمع معلومات مثل اسمك ولقبك وعنوان بريدك الإلكتروني ورقم هاتفك من خلال نماذج الاتصال على موقعنا. يتم استخدام هذه المعلومات فقط للرد عليك.' : 'Web sitemizdeki iletişim formları aracılığıyla adınız, soyadınız, e-posta adresiniz ve telefon numaranız gibi bilgiler toplanabilir. Bu bilgiler sadece size geri dönüş yapmak amacıyla kullanılır.')}</p>
            </section>

            <section>
              <h2 class="text-white text-2xl font-bold mb-4">3. {lang === 'en' ? 'Cookies' : (lang === 'ar' ? 'ملفات تعريف الارتباط (Cookies)' : 'Çerezler (Cookies)')}</h2>
              <p>{lang === 'en' ? 'We use cookies to improve user experience. Cookies are small text files that are saved to your browser when you visit our website.' : (lang === 'ar' ? 'نحن نستخدم ملفات تعريف الارتباط لتحسين تجربة المستخدم. ملفات تعريف الارتباط هي ملفات نصية صغيرة يتم حفظها في متصفحك عند زيارة موقعنا.' : 'Kullanıcı deneyimini geliştirmek için çerezler kullanmaktayız. Çerezler, web sitemizi ziyaret ettiğinizde tarayıcınıza kaydedilen küçük metin dosyalarıdır.')}</p>
            </section>
            
            <section>
              <h2 class="text-white text-2xl font-bold mb-4">4. {lang === 'en' ? 'Your Rights' : (lang === 'ar' ? 'حقوقك' : 'Haklarınız')}</h2>
              <p>{lang === 'en' ? `You reserve the right to request the deletion or correction of your data within the scope of KVKK/GDPR. You can reach us at ${settingsData?.contact?.email || 'info@bybossmimarlik.com'}.` : (lang === 'ar' ? `تحتفظ بالحق في طلب حذف بياناتك أو تصحيحها في نطاق قانون حماية البيانات الشخصية. يمكنك الوصول إلينا على ${settingsData?.contact?.email || 'info@bybossmimarlik.com'}.` : `KVKK kapsamında verilerinizin silinmesini veya düzeltilmesini talep etme hakkınız saklıdır. Bize ${settingsData?.contact?.email || 'info@bybossmimarlik.com'} adresinden ulaşabilirsiniz.`)}</p>
            </section>
          </div>
        )}
      </div>
    </div>

    <Footer client:visible data={settingsData} navData={navData?.footer} />
  </main>
</Layout>
